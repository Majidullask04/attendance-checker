# Attendance Backend Environment Variables

# Define the port the server will run on
PORT=3001

# Node environment: 'development' or 'production'
NODE_ENV=development

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Secret key for JWT signing (MUST set in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Shared secret required by the Layer 5 biometric ingest webhook (x-device-key header)
BIOMETRIC_DEVICE_KEY=change_me_device_key
EOF
